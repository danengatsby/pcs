# No client environment variables are required for the signup form or production build.
# Never store server secrets in VITE_* variables: they are included in public bundles.

# Public contact details shown until the national organization registry provides them.
# VITE_PUBLIC_CONTACT_EMAIL=contact@example.org
# VITE_PUBLIC_CONTACT_PHONE=+40 000 000 000
# VITE_PUBLIC_OFFICE_HOURS=Luni–Vineri, 09:00–17:00; audiențe cu programare.

# Optional browser tracing.
VITE_OTEL_ENABLED=false
# VITE_OTEL_EXPORTER_URL=https://otel.example.org/v1/traces
