# No client environment variables are required for the signup form or production build.
# Never store server secrets in VITE_* variables: they are included in public bundles.

# Public contact details shown until the national organization registry provides them.
# VITE_PUBLIC_CONTACT_EMAIL=contact@example.org
# VITE_PUBLIC_CONTACT_PHONE=+40 000 000 000
# VITE_PUBLIC_OFFICE_HOURS=Luni–Vineri, 09:00–17:00; audiențe cu programare.

# Optional browser tracing.
VITE_OTEL_ENABLED=false
# VITE_OTEL_EXPORTER_URL=https://otel.example.org/v1/traces

# TEMPORAR / DOAR PENTRU TESTARE LOCALĂ (npm run dev):
# Dacă ambele valori sunt setate, pagina de autentificare afișează un buton
# suplimentar "🧪 Autentificare admin (doar dev)" care completează automat
# formularul cu aceste credențiale și trimite cererea reală de login către
# server (parola tot este verificată de server, nu există bypass de auth).
# Acest cod este eliminat automat din build-ul de producție deoarece este
# protejat de `import.meta.env.DEV`. NU seta aceste variabile în .env.production
# și NU le folosi cu credențialele contului de admin real din producție.
# VITE_DEV_ADMIN_EMAIL=seed.national.presedinte@example.test
# VITE_DEV_ADMIN_PASSWORD=parola-locala-de-test
