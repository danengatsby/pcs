generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     BigInt      @id @default(autoincrement()) @db.BigInt
  fullName               String      @map("full_name") @db.VarChar(160)
  email                  String      @db.VarChar(180)
  passwordHash           String      @map("password_hash") @db.VarChar(255)
  role                   String      @db.VarChar(20)
  createdAt              DateTime    @map("created_at") @default(now()) @db.Timestamptz(6)
  refreshTokens          AuthRefreshToken[]
  adminAuditEntries      AdminAuditLog[] @relation("AdminAuditActor")
  volunteersOwned        Volunteer[] @relation("VolunteerOwner")
  volunteersStatusUpdate Volunteer[] @relation("VolunteerStatusUpdatedBy")
  newsMediaAssetsCreated NewsMediaAsset[]
  executiveTargetsUpdated ExecutiveTarget[] @relation("ExecutiveTargetUpdatedBy")
  organizationsCreated    Organization[] @relation("OrganizationCreatedBy")
  organizationsUpdated    Organization[] @relation("OrganizationUpdatedBy")
  organizationMandates    OrganizationLeadershipMandate[]
  membershipRecord        MembershipRecord? @relation("MembershipSubjectUser")
  membershipsCreated      MembershipRecord[] @relation("MembershipCreatedBy")
  membershipsUpdated      MembershipRecord[] @relation("MembershipUpdatedBy")
  membershipEvents        MembershipEvent[] @relation("MembershipEventActor")

  @@map("users")
}

model County {
  id             Int         @id @default(autoincrement())
  name           String      @unique @db.VarChar(120)
  normalizedName String      @unique @map("normalized_name") @db.VarChar(120)
  createdAt      DateTime    @map("created_at") @default(now()) @db.Timestamptz(6)
  volunteers     Volunteer[]
  organizationTerritories OrganizationTerritory[]

  @@map("counties")
}

model News {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(180)
  summary     String   @db.VarChar(320)
  category    String   @default("Comunicat") @db.VarChar(80)
  content     String   @default("") @db.Text
  sourceName  String   @map("source_name") @default("") @db.VarChar(160)
  sourceUrl   String   @map("source_url") @default("") @db.VarChar(1000)
  status      String   @default("published") @db.VarChar(20)
  tags        Json
  publishedAt DateTime @map("published_at") @default(now()) @db.Timestamptz(6)
  createdAt   DateTime @map("created_at") @default(now()) @db.Timestamptz(6)
  mediaLinks  NewsMediaLink[]

  @@map("news")
}

model NewsMediaAsset {
  id           BigInt         @id @default(autoincrement()) @db.BigInt
  storagePath  String         @unique @map("storage_path") @db.VarChar(600)
  publicUrl    String         @unique @map("public_url") @db.VarChar(600)
  originalName String         @map("original_name") @db.VarChar(255)
  mimeType     String         @map("mime_type") @db.VarChar(120)
  sizeBytes    BigInt         @map("size_bytes") @db.BigInt
  kind         String         @db.VarChar(20)
  title        String         @default("") @db.VarChar(180)
  alt          String         @default("") @db.VarChar(240)
  createdBy    BigInt?        @map("created_by") @db.BigInt
  createdByRef User?          @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  deletedAt    DateTime?      @map("deleted_at") @db.Timestamptz(6)
  createdAt    DateTime       @map("created_at") @default(now()) @db.Timestamptz(6)
  links        NewsMediaLink[]

  @@map("news_media_assets")
}

model NewsMediaLink {
  id        BigInt         @id @default(autoincrement()) @db.BigInt
  newsId    Int            @map("news_id")
  assetId   BigInt         @map("asset_id") @db.BigInt
  kind      String         @db.VarChar(20)
  title     String         @default("") @db.VarChar(180)
  alt       String         @default("") @db.VarChar(240)
  sortOrder Int            @default(0) @map("sort_order")
  createdAt DateTime       @map("created_at") @default(now()) @db.Timestamptz(6)
  news      News           @relation(fields: [newsId], references: [id], onDelete: Cascade)
  asset     NewsMediaAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([newsId, assetId])
  @@map("news_media_links")
}

model Volunteer {
  id                 BigInt    @id @default(autoincrement()) @db.BigInt
  fullName           String    @map("full_name") @db.VarChar(160)
  email              String    @db.VarChar(180)
  phone              String    @db.VarChar(40)
  county             String    @db.VarChar(120)
  countyId           Int?      @map("county_id")
  countyRef          County?   @relation(fields: [countyId], references: [id], onDelete: Restrict)
  locality           String    @db.VarChar(120)
  skills             String    @db.VarChar(220)
  motivation         String    @db.Text
  workflowStatus     String    @map("workflow_status") @default("nou") @db.VarChar(20)
  internalNotes      String    @map("internal_notes") @default("") @db.Text
  statusUpdatedAt    DateTime? @map("status_updated_at") @db.Timestamptz(6)
  statusUpdatedBy    BigInt?   @map("status_updated_by") @db.BigInt
  statusUpdatedByRef User?     @relation("VolunteerStatusUpdatedBy", fields: [statusUpdatedBy], references: [id], onDelete: SetNull)
  ownerUserId        BigInt?   @map("owner_user_id") @db.BigInt
  ownerUserRef       User?     @relation("VolunteerOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  followUpAt         DateTime? @map("follow_up_at") @db.Timestamptz(6)
  reminderAt         DateTime? @map("reminder_at") @db.Timestamptz(6)
  lastContactAt      DateTime? @map("last_contact_at") @db.Timestamptz(6)
  contactChannel     String?   @map("contact_channel") @db.VarChar(30)
  crmPriority        String    @map("crm_priority") @default("medie") @db.VarChar(20)
  rejectionReason    String    @map("rejection_reason") @default("") @db.Text
  crmTags            Json      @map("crm_tags") @default("[]")
  skillTags          Json      @map("skill_tags") @default("[]")
  createdAt          DateTime  @map("created_at") @default(now()) @db.Timestamptz(6)
  membershipRecord   MembershipRecord?

  @@map("volunteers")
}

model RateLimitEntry {
  scope       String   @db.VarChar(100)
  keyHash     String   @map("key_hash") @db.Char(64)
  windowStart DateTime @map("window_start") @db.Timestamptz(6)
  hits        Int      @default(1)
  updatedAt   DateTime @map("updated_at") @default(now()) @db.Timestamptz(6)

  @@id([scope, keyHash])
  @@map("rate_limit_entries")
}

model AuthRevokedToken {
  jti       String   @id @db.VarChar(120)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime @map("revoked_at") @default(now()) @db.Timestamptz(6)

  @@map("auth_revoked_tokens")
}

model AuthRefreshToken {
  id            BigInt    @id @default(autoincrement()) @db.BigInt
  tokenHash     String    @unique @map("token_hash") @db.Char(64)
  csrfTokenHash String    @map("csrf_token_hash") @db.Char(64)
  userId        BigInt    @map("user_id") @db.BigInt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  rotatedFromId BigInt?   @map("rotated_from_id") @db.BigInt
  rotatedToId   BigInt?   @map("rotated_to_id") @db.BigInt
  userAgent     String    @map("user_agent") @db.VarChar(255)
  ipAddress     String    @map("ip_address") @db.VarChar(120)
  createdAt     DateTime  @map("created_at") @default(now()) @db.Timestamptz(6)

  @@map("auth_refresh_tokens")
}

model AdminAuditLog {
  id         BigInt    @id @default(autoincrement()) @db.BigInt
  actorUserId BigInt?  @map("actor_user_id") @db.BigInt
  actorUser   User?    @relation("AdminAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorEmail String    @map("actor_email") @db.VarChar(180)
  actorRole  String    @map("actor_role") @db.VarChar(20)
  action     String    @db.VarChar(120)
  targetType String    @map("target_type") @db.VarChar(80)
  targetId   String    @map("target_id") @db.VarChar(120)
  details    Json      @db.JsonB
  createdAt  DateTime  @map("created_at") @default(now()) @db.Timestamptz(6)

  @@map("admin_audit_log")
}

model NotificationEmailOutbox {
  id           BigInt    @id @default(autoincrement()) @db.BigInt
  eventId      String    @unique @map("event_id") @db.VarChar(120)
  action       String    @db.VarChar(120)
  payload      Json      @db.JsonB
  status       String    @default("pending") @db.VarChar(20)
  attemptCount Int       @map("attempt_count") @default(0)
  maxAttempts  Int       @map("max_attempts") @default(6)
  nextAttemptAt DateTime @map("next_attempt_at") @default(now()) @db.Timestamptz(6)
  lastError    String    @map("last_error") @default("") @db.Text
  lockedAt     DateTime? @map("locked_at") @db.Timestamptz(6)
  sentAt       DateTime? @map("sent_at") @db.Timestamptz(6)
  deliveryUnknownAt DateTime? @map("delivery_unknown_at") @db.Timestamptz(6)
  createdAt    DateTime  @map("created_at") @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @map("updated_at") @default(now()) @db.Timestamptz(6)

  @@map("notification_email_outbox")
}

model AdminAuditOutbox {
  id            BigInt    @id @default(autoincrement()) @db.BigInt
  action        String    @db.VarChar(120)
  payload       Json      @db.JsonB
  status        String    @default("pending") @db.VarChar(20)
  attemptCount  Int       @map("attempt_count") @default(0)
  maxAttempts   Int       @map("max_attempts") @default(6)
  nextAttemptAt DateTime  @map("next_attempt_at") @default(now()) @db.Timestamptz(6)
  lastError     String    @map("last_error") @default("") @db.Text
  lockedAt      DateTime? @map("locked_at") @db.Timestamptz(6)
  sentAt        DateTime? @map("sent_at") @db.Timestamptz(6)
  createdAt     DateTime  @map("created_at") @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @map("updated_at") @default(now()) @db.Timestamptz(6)

  @@map("admin_audit_outbox")
}

model Organization {
  id            String   @id @db.VarChar(80)
  code          String   @db.VarChar(80)
  level         String   @db.VarChar(20)
  name          String   @db.VarChar(180)
  county        String   @db.VarChar(120)
  membersCount  Int      @map("members_count") @default(0)
  status        String   @default("forming") @db.VarChar(20)
  parentId      String?  @map("parent_id") @db.VarChar(80)
  parent        Organization? @relation("OrganizationHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children      Organization[] @relation("OrganizationHierarchy")
  officialEmail String   @map("official_email") @default("") @db.VarChar(180)
  phone         String   @default("") @db.VarChar(40)
  headquarters  String   @default("") @db.VarChar(260)
  foundedAt     DateTime? @map("founded_at") @db.Date
  createdBy     BigInt?  @map("created_by") @db.BigInt
  createdByRef  User?    @relation("OrganizationCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedBy     BigInt?  @map("updated_by") @db.BigInt
  updatedByRef  User?    @relation("OrganizationUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  territories   OrganizationTerritory[]
  mandates      OrganizationLeadershipMandate[]
  objectives    OrganizationObjective[]
  memberships   MembershipRecord[]
  approvedMemberships MembershipRecord[] @relation("MembershipApprovalOrganization")
  createdAt     DateTime @map("created_at") @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @map("updated_at") @default(now()) @db.Timestamptz(6)

  @@index([parentId], map: "idx_organizations_parent_id")
  @@index([status, level], map: "idx_organizations_status_level")
  @@index([county], map: "idx_organizations_county")
  @@map("organizations")
}

model OrganizationTerritory {
  id             BigInt       @id @default(autoincrement()) @db.BigInt
  organizationId String       @map("organization_id") @db.VarChar(80)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  territoryType  String       @map("territory_type") @db.VarChar(20)
  countyId       Int?         @map("county_id")
  countyRef      County?      @relation(fields: [countyId], references: [id], onDelete: Restrict)
  locality       String       @default("") @db.VarChar(160)
  createdAt      DateTime     @map("created_at") @default(now()) @db.Timestamptz(6)

  @@index([organizationId], map: "idx_organization_territories_organization")
  @@index([countyId], map: "idx_organization_territories_county")
  @@map("organization_territories")
}

model OrganizationLeadershipMandate {
  id             BigInt       @id @default(autoincrement()) @db.BigInt
  organizationId String       @map("organization_id") @db.VarChar(80)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         BigInt?      @map("user_id") @db.BigInt
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  fullName       String       @map("full_name") @db.VarChar(160)
  positionTitle  String       @map("position_title") @db.VarChar(120)
  startedAt      DateTime     @map("started_at") @db.Date
  endedAt        DateTime?    @map("ended_at") @db.Date
  status         String       @default("active") @db.VarChar(20)
  createdAt      DateTime     @map("created_at") @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime     @map("updated_at") @default(now()) @db.Timestamptz(6)

  @@index([organizationId, status], map: "idx_organization_mandates_org_status")
  @@index([userId], map: "idx_organization_mandates_user")
  @@map("organization_leadership_mandates")
}

model OrganizationObjective {
  id             BigInt       @id @default(autoincrement()) @db.BigInt
  organizationId String       @map("organization_id") @db.VarChar(80)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String       @db.VarChar(180)
  description    String       @default("") @db.Text
  metricName     String       @map("metric_name") @default("") @db.VarChar(120)
  targetValue    Decimal      @map("target_value") @db.Decimal(14, 2)
  currentValue   Decimal      @map("current_value") @default(0) @db.Decimal(14, 2)
  unit           String       @default("număr") @db.VarChar(40)
  dueDate        DateTime     @map("due_date") @db.Date
  status         String       @default("planned") @db.VarChar(20)
  createdAt      DateTime     @map("created_at") @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime     @map("updated_at") @default(now()) @db.Timestamptz(6)

  @@index([organizationId, status], map: "idx_organization_objectives_org_status")
  @@index([dueDate], map: "idx_organization_objectives_due_date")
  @@map("organization_objectives")
}

model MembershipRecord {
  id             BigInt        @id @default(autoincrement()) @db.BigInt
  userId         BigInt?       @unique @map("user_id") @db.BigInt
  user           User?         @relation("MembershipSubjectUser", fields: [userId], references: [id], onDelete: SetNull)
  volunteerId    BigInt?       @unique @map("volunteer_id") @db.BigInt
  volunteer      Volunteer?    @relation(fields: [volunteerId], references: [id], onDelete: SetNull)
  fullName       String        @map("full_name") @db.VarChar(160)
  email          String        @db.VarChar(180)
  status         String        @default("application") @db.VarChar(20)
  organizationId String?       @map("organization_id") @db.VarChar(80)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  memberNumber   String?       @unique(map: "idx_membership_records_member_number_unique") @map("member_number") @db.VarChar(32)
  applicationAt  DateTime      @map("application_at") @default(now()) @db.Timestamptz(6)
  validatedAt    DateTime?     @map("validated_at") @db.Timestamptz(6)
  approvedAt     DateTime?     @map("approved_at") @db.Timestamptz(6)
  approvalOrganizationId String? @map("approval_organization_id") @db.VarChar(80)
  approvalOrganization Organization? @relation("MembershipApprovalOrganization", fields: [approvalOrganizationId], references: [id], onDelete: Restrict)
  approvalBody   String        @map("approval_body") @default("") @db.VarChar(180)
  joinedAt       DateTime?     @map("joined_at") @db.Timestamptz(6)
  suspendedAt    DateTime?     @map("suspended_at") @db.Timestamptz(6)
  endedAt        DateTime?     @map("ended_at") @db.Timestamptz(6)
  statusReason   String        @map("status_reason") @default("") @db.Text
  version        Int           @default(1)
  createdBy      BigInt?       @map("created_by") @db.BigInt
  createdByRef   User?         @relation("MembershipCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedBy      BigInt?       @map("updated_by") @db.BigInt
  updatedByRef   User?         @relation("MembershipUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  events         MembershipEvent[]
  createdAt      DateTime      @map("created_at") @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime      @map("updated_at") @default(now()) @db.Timestamptz(6)

  @@index([status, updatedAt], map: "idx_membership_records_status_updated")
  @@index([organizationId, status], map: "idx_membership_records_organization_status")
  @@index([applicationAt], map: "idx_membership_records_application_at")
  @@index([approvalOrganizationId, approvedAt], map: "idx_membership_records_approval_organization")
  @@map("membership_records")
}

model MembershipEvent {
  id                     BigInt            @id @default(autoincrement()) @db.BigInt
  membershipId           BigInt            @map("membership_id") @db.BigInt
  membership             MembershipRecord  @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  action                 String            @db.VarChar(30)
  previousStatus         String?           @map("previous_status") @db.VarChar(20)
  nextStatus             String            @map("next_status") @db.VarChar(20)
  previousOrganizationId String?           @map("previous_organization_id") @db.VarChar(80)
  nextOrganizationId     String?           @map("next_organization_id") @db.VarChar(80)
  reason                 String            @default("") @db.Text
  actorUserId            BigInt?           @map("actor_user_id") @db.BigInt
  actorUser              User?             @relation("MembershipEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  effectiveAt            DateTime           @map("effective_at") @default(now()) @db.Timestamptz(6)
  createdAt              DateTime           @map("created_at") @default(now()) @db.Timestamptz(6)

  @@index([membershipId, createdAt], map: "idx_membership_events_membership_created")
  @@index([actorUserId], map: "idx_membership_events_actor")
  @@map("membership_events")
}

model ExecutiveTarget {
  key          String   @id @db.VarChar(60)
  label        String   @db.VarChar(160)
  targetValue  Decimal  @map("target_value") @db.Decimal(12, 2)
  unit         String   @db.VarChar(20)
  direction    String   @db.VarChar(20)
  updatedBy    BigInt?  @map("updated_by") @db.BigInt
  updatedByRef User?    @relation("ExecutiveTargetUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  createdAt    DateTime @map("created_at") @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @map("updated_at") @default(now()) @db.Timestamptz(6)

  @@map("executive_targets")
}

model MobilizationAction {
  id                BigInt   @id @default(autoincrement()) @db.BigInt
  slug              String   @unique @db.VarChar(120)
  actionType        String   @map("action_type") @db.VarChar(30)
  title             String   @db.VarChar(180)
  summary           String   @db.VarChar(360)
  description       String   @default("") @db.Text
  status            String   @default("open") @db.VarChar(20)
  scope             String   @default("national") @db.VarChar(20)
  county            String   @default("") @db.VarChar(120)
  locality          String   @default("") @db.VarChar(120)
  startsAt          DateTime? @map("starts_at") @db.Timestamptz(6)
  endsAt            DateTime? @map("ends_at") @db.Timestamptz(6)
  participationMode String   @map("participation_mode") @default("") @db.VarChar(120)
  commitment        String   @default("") @db.VarChar(220)
  capacity          Int?
  sortOrder         Int      @map("sort_order") @default(0)
  organizationId    String?  @map("organization_id") @db.VarChar(80)
  coordinatorUserId BigInt?  @map("coordinator_user_id") @db.BigInt
  objective         String   @default("") @db.Text
  targetMetric      String   @map("target_metric") @default("") @db.VarChar(120)
  targetValue       Decimal? @map("target_value") @db.Decimal(14, 2)
  resultValue       Decimal? @map("result_value") @db.Decimal(14, 2)
  resultSummary     String   @map("result_summary") @default("") @db.Text
  visibility        String   @default("public") @db.VarChar(20)
  createdBy         BigInt?  @map("created_by") @db.BigInt
  version           Int      @default(1)
  createdAt         DateTime @map("created_at") @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime @map("updated_at") @default(now()) @db.Timestamptz(6)
  responses         MobilizationResponse[]

  @@map("mobilization_actions")
}

model MobilizationResponse {
  id               BigInt   @id @default(autoincrement()) @db.BigInt
  actionId         BigInt   @map("action_id") @db.BigInt
  action           MobilizationAction @relation(fields: [actionId], references: [id], onDelete: Cascade)
  fullName         String   @map("full_name") @db.VarChar(160)
  email            String   @db.VarChar(180)
  phone            String   @default("") @db.VarChar(40)
  county           String   @db.VarChar(120)
  locality         String   @default("") @db.VarChar(120)
  interests        Json     @default("[]")
  availability     String   @default("") @db.VarChar(30)
  message          String   @default("") @db.Text
  updatesConsent   Boolean  @map("updates_consent") @default(false)
  emailConsent     Boolean  @map("email_consent") @default(false)
  smsConsent       Boolean  @map("sms_consent") @default(false)
  whatsappConsent  Boolean  @map("whatsapp_consent") @default(false)
  consentVersion   String   @map("consent_version") @default("mobilizare-v1") @db.VarChar(40)
  privacyConsent   Boolean  @map("privacy_consent")
  createdAt        DateTime @map("created_at") @default(now()) @db.Timestamptz(6)

  @@map("mobilization_responses")
}

model MobilizationActionCounty {
  actionId BigInt   @map("action_id") @db.BigInt
  countyId Int      @map("county_id")
  createdAt DateTime @map("created_at") @default(now()) @db.Timestamptz(6)

  @@id([actionId, countyId])
  @@map("mobilization_action_counties")
}

model MobilizationParticipant {
  id                BigInt    @id @default(autoincrement()) @db.BigInt
  actionId          BigInt    @map("action_id") @db.BigInt
  userId            BigInt?   @map("user_id") @db.BigInt
  membershipId      BigInt?   @map("membership_id") @db.BigInt
  fullName          String    @map("full_name") @db.VarChar(160)
  email             String    @db.VarChar(180)
  participationRole String    @map("participation_role") @default("participant") @db.VarChar(24)
  status            String    @default("invited") @db.VarChar(24)
  attendanceStatus  String    @map("attendance_status") @default("not_applicable") @db.VarChar(20)
  dueAt             DateTime? @map("due_at") @db.Timestamptz(6)
  notes             String    @default("") @db.Text
  report            String    @default("") @db.Text
  result            String    @default("") @db.Text
  hours             Decimal   @default(0) @db.Decimal(8, 2)
  invitedAt         DateTime? @map("invited_at") @db.Timestamptz(6)
  respondedAt       DateTime? @map("responded_at") @db.Timestamptz(6)
  checkedInAt       DateTime? @map("checked_in_at") @db.Timestamptz(6)
  reportedAt        DateTime? @map("reported_at") @db.Timestamptz(6)
  reviewedAt        DateTime? @map("reviewed_at") @db.Timestamptz(6)
  assignedBy        BigInt?   @map("assigned_by") @db.BigInt
  createdAt         DateTime  @map("created_at") @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime  @map("updated_at") @default(now()) @db.Timestamptz(6)

  @@index([userId, status, updatedAt], map: "idx_mobilization_participants_user")
  @@index([membershipId, status, updatedAt], map: "idx_mobilization_participants_membership")
  @@map("mobilization_participants")
}

model CommunicationConsent {
