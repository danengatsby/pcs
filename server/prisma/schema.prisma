generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      BigInt                          @id @default(autoincrement()) @db.BigInt
  fullName                String                          @map("full_name") @db.VarChar(160)
  email                   String                          @db.VarChar(180)
  passwordHash            String                          @map("password_hash") @db.VarChar(255)
  role                    String                          @db.VarChar(20)
  isDemo                  Boolean                         @default(false) @map("is_demo")
  createdAt               DateTime                        @default(now()) @map("created_at") @db.Timestamptz(6)
  refreshTokens           AuthRefreshToken[]
  adminAuditEntries       AdminAuditLog[]                 @relation("AdminAuditActor")
  volunteersOwned         Volunteer[]                     @relation("VolunteerOwner")
  volunteersStatusUpdate  Volunteer[]                     @relation("VolunteerStatusUpdatedBy")
  newsMediaAssetsCreated  NewsMediaAsset[]
  executiveTargetsUpdated ExecutiveTarget[]               @relation("ExecutiveTargetUpdatedBy")
  organizationsCreated    Organization[]                  @relation("OrganizationCreatedBy")
  organizationsUpdated    Organization[]                  @relation("OrganizationUpdatedBy")
  organizationMandates    OrganizationLeadershipMandate[]
  membershipRecord        MembershipRecord?               @relation("MembershipSubjectUser")
  membershipsCreated      MembershipRecord[]              @relation("MembershipCreatedBy")
  membershipsUpdated      MembershipRecord[]              @relation("MembershipUpdatedBy")
  membershipEvents        MembershipEvent[]               @relation("MembershipEventActor")

  @@map("users")
}

model County {
  id                      Int                     @id @default(autoincrement())
  name                    String                  @unique @db.VarChar(120)
  normalizedName          String                  @unique @map("normalized_name") @db.VarChar(120)
  createdAt               DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  volunteers              Volunteer[]
  organizationTerritories OrganizationTerritory[]

  @@map("counties")
}

model News {
  id               Int             @id @default(autoincrement())
  title            String          @db.VarChar(180)
  summary          String          @db.VarChar(320)
  category         String          @default("Comunicat") @db.VarChar(80)
  content          String          @default("") @db.Text
  sourceName       String          @default("") @map("source_name") @db.VarChar(160)
  sourceUrl        String          @default("") @map("source_url") @db.VarChar(1000)
  status           String          @default("published") @db.VarChar(20)
  isDemo           Boolean         @default(false) @map("is_demo")
  publicApprovedAt DateTime?       @map("public_approved_at") @db.Timestamptz(6)
  publicApprovedBy BigInt?         @map("public_approved_by") @db.BigInt
  tags             Json
  publishedAt      DateTime        @default(now()) @map("published_at") @db.Timestamptz(6)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  mediaLinks       NewsMediaLink[]

  @@map("news")
}

model NewsMediaAsset {
  id           BigInt          @id @default(autoincrement()) @db.BigInt
  storagePath  String          @unique @map("storage_path") @db.VarChar(600)
  publicUrl    String          @unique @map("public_url") @db.VarChar(600)
  originalName String          @map("original_name") @db.VarChar(255)
  mimeType     String          @map("mime_type") @db.VarChar(120)
  sizeBytes    BigInt          @map("size_bytes") @db.BigInt
  kind         String          @db.VarChar(20)
  title        String          @default("") @db.VarChar(180)
  alt          String          @default("") @db.VarChar(240)
  createdBy    BigInt?         @map("created_by") @db.BigInt
  createdByRef User?           @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  deletedAt    DateTime?       @map("deleted_at") @db.Timestamptz(6)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  links        NewsMediaLink[]

  @@map("news_media_assets")
}

model NewsMediaLink {
  id        BigInt         @id @default(autoincrement()) @db.BigInt
  newsId    Int            @map("news_id")
  assetId   BigInt         @map("asset_id") @db.BigInt
  kind      String         @db.VarChar(20)
  title     String         @default("") @db.VarChar(180)
  alt       String         @default("") @db.VarChar(240)
  sortOrder Int            @default(0) @map("sort_order")
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  news      News           @relation(fields: [newsId], references: [id], onDelete: Cascade)
  asset     NewsMediaAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([newsId, assetId])
  @@map("news_media_links")
}

model Volunteer {
  id                 BigInt            @id @default(autoincrement()) @db.BigInt
  fullName           String            @map("full_name") @db.VarChar(160)
  email              String            @db.VarChar(180)
  phone              String            @db.VarChar(40)
  county             String            @db.VarChar(120)
  countyId           Int?              @map("county_id")
  countyRef          County?           @relation(fields: [countyId], references: [id], onDelete: Restrict)
  locality           String            @db.VarChar(120)
  skills             String            @db.VarChar(220)
  motivation         String            @db.Text
  workflowStatus     String            @default("nou") @map("workflow_status") @db.VarChar(20)
  isDemo             Boolean           @default(false) @map("is_demo")
  internalNotes      String            @default("") @map("internal_notes") @db.Text
  statusUpdatedAt    DateTime?         @map("status_updated_at") @db.Timestamptz(6)
  statusUpdatedBy    BigInt?           @map("status_updated_by") @db.BigInt
  statusUpdatedByRef User?             @relation("VolunteerStatusUpdatedBy", fields: [statusUpdatedBy], references: [id], onDelete: SetNull)
  ownerUserId        BigInt?           @map("owner_user_id") @db.BigInt
  ownerUserRef       User?             @relation("VolunteerOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  followUpAt         DateTime?         @map("follow_up_at") @db.Timestamptz(6)
  reminderAt         DateTime?         @map("reminder_at") @db.Timestamptz(6)
  lastContactAt      DateTime?         @map("last_contact_at") @db.Timestamptz(6)
  contactChannel     String?           @map("contact_channel") @db.VarChar(30)
  crmPriority        String            @default("medie") @map("crm_priority") @db.VarChar(20)
  rejectionReason    String            @default("") @map("rejection_reason") @db.Text
  crmTags            Json              @default("[]") @map("crm_tags")
  skillTags          Json              @default("[]") @map("skill_tags")
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  membershipRecord   MembershipRecord?

  @@map("volunteers")
}

model RateLimitEntry {
  scope       String   @db.VarChar(100)
  keyHash     String   @map("key_hash") @db.Char(64)
  windowStart DateTime @map("window_start") @db.Timestamptz(6)
  hits        Int      @default(1)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@id([scope, keyHash])
  @@map("rate_limit_entries")
}

model AuthRevokedToken {
  jti       String   @id @db.VarChar(120)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime @default(now()) @map("revoked_at") @db.Timestamptz(6)

  @@map("auth_revoked_tokens")
}

model AuthRefreshToken {
  id            BigInt    @id @default(autoincrement()) @db.BigInt
  tokenHash     String    @unique @map("token_hash") @db.Char(64)
  csrfTokenHash String    @map("csrf_token_hash") @db.Char(64)
  userId        BigInt    @map("user_id") @db.BigInt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  rotatedFromId BigInt?   @map("rotated_from_id") @db.BigInt
  rotatedToId   BigInt?   @map("rotated_to_id") @db.BigInt
  userAgent     String    @map("user_agent") @db.VarChar(255)
  ipAddress     String    @map("ip_address") @db.VarChar(120)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("auth_refresh_tokens")
}

model AdminAuditLog {
  id          BigInt   @id @default(autoincrement()) @db.BigInt
  actorUserId BigInt?  @map("actor_user_id") @db.BigInt
  actorUser   User?    @relation("AdminAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorEmail  String   @map("actor_email") @db.VarChar(180)
  actorRole   String   @map("actor_role") @db.VarChar(20)
  action      String   @db.VarChar(120)
  targetType  String   @map("target_type") @db.VarChar(80)
  targetId    String   @map("target_id") @db.VarChar(120)
  details     Json     @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("admin_audit_log")
}

model NotificationEmailOutbox {
  id                BigInt    @id @default(autoincrement()) @db.BigInt
  eventId           String    @unique @map("event_id") @db.VarChar(120)
  action            String    @db.VarChar(120)
  payload           Json      @db.JsonB
  status            String    @default("pending") @db.VarChar(20)
  attemptCount      Int       @default(0) @map("attempt_count")
  maxAttempts       Int       @default(6) @map("max_attempts")
  nextAttemptAt     DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  lastError         String    @default("") @map("last_error") @db.Text
  lockedAt          DateTime? @map("locked_at") @db.Timestamptz(6)
  sentAt            DateTime? @map("sent_at") @db.Timestamptz(6)
  deliveryUnknownAt DateTime? @map("delivery_unknown_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("notification_email_outbox")
}

model AdminAuditOutbox {
  id            BigInt    @id @default(autoincrement()) @db.BigInt
  action        String    @db.VarChar(120)
  payload       Json      @db.JsonB
  status        String    @default("pending") @db.VarChar(20)
  attemptCount  Int       @default(0) @map("attempt_count")
  maxAttempts   Int       @default(6) @map("max_attempts")
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  lastError     String    @default("") @map("last_error") @db.Text
  lockedAt      DateTime? @map("locked_at") @db.Timestamptz(6)
  sentAt        DateTime? @map("sent_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("admin_audit_outbox")
}

model Organization {
  id                  String                          @id @db.VarChar(80)
  code                String                          @db.VarChar(80)
  level               String                          @db.VarChar(20)
  name                String                          @db.VarChar(180)
  county              String                          @db.VarChar(120)
  membersCount        Int                             @default(0) @map("members_count")
  status              String                          @default("forming") @db.VarChar(20)
  isDemo              Boolean                         @default(false) @map("is_demo")
  publicApprovedAt    DateTime?                       @map("public_approved_at") @db.Timestamptz(6)
  publicApprovedBy    BigInt?                         @map("public_approved_by") @db.BigInt
  parentId            String?                         @map("parent_id") @db.VarChar(80)
  parent              Organization?                   @relation("OrganizationHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children            Organization[]                  @relation("OrganizationHierarchy")
  officialEmail       String                          @default("") @map("official_email") @db.VarChar(180)
  phone               String                          @default("") @db.VarChar(40)
  headquarters        String                          @default("") @db.VarChar(260)
  foundedAt           DateTime?                       @map("founded_at") @db.Date
  createdBy           BigInt?                         @map("created_by") @db.BigInt
  createdByRef        User?                           @relation("OrganizationCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedBy           BigInt?                         @map("updated_by") @db.BigInt
  updatedByRef        User?                           @relation("OrganizationUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  territories         OrganizationTerritory[]
  mandates            OrganizationLeadershipMandate[]
  mandateDecisions    OrganizationMandateDecision[]
  arbitrationCases    ArbitrationCase[]
  objectives          OrganizationObjective[]
  memberships         MembershipRecord[]
  approvedMemberships MembershipRecord[]              @relation("MembershipApprovalOrganization")
  createdAt           DateTime                        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                        @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([parentId], map: "idx_organizations_parent_id")
  @@index([status, level], map: "idx_organizations_status_level")
  @@index([county], map: "idx_organizations_county")
  @@map("organizations")
}

model OrganizationTerritory {
  id             BigInt       @id @default(autoincrement()) @db.BigInt
  organizationId String       @map("organization_id") @db.VarChar(80)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  territoryType  String       @map("territory_type") @db.VarChar(20)
  countyId       Int?         @map("county_id")
  countyRef      County?      @relation(fields: [countyId], references: [id], onDelete: Restrict)
  locality       String       @default("") @db.VarChar(160)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([organizationId], map: "idx_organization_territories_organization")
  @@index([countyId], map: "idx_organization_territories_county")
  @@map("organization_territories")
}

model OrganizationLeadershipMandate {
  id               BigInt                       @id @default(autoincrement()) @db.BigInt
  organizationId   String                       @map("organization_id") @db.VarChar(80)
  organization     Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId           BigInt?                      @map("user_id") @db.BigInt
  user             User?                        @relation(fields: [userId], references: [id], onDelete: SetNull)
  fullName         String                       @map("full_name") @db.VarChar(160)
  positionTitle    String                       @map("position_title") @db.VarChar(120)
  startedAt        DateTime                     @map("started_at") @db.Date
  endedAt          DateTime?                    @map("ended_at") @db.Date
  status           String                       @default("active") @db.VarChar(20)
  isDemo           Boolean                      @default(false) @map("is_demo")
  publicApprovedAt DateTime?                    @map("public_approved_at") @db.Timestamptz(6)
  publicApprovedBy BigInt?                      @map("public_approved_by") @db.BigInt
  decisionId       BigInt?                      @map("decision_id") @db.BigInt
  decision         OrganizationMandateDecision? @relation(fields: [decisionId], references: [id], onDelete: Restrict)
  createdAt        DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                     @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([organizationId, status], map: "idx_organization_mandates_org_status")
  @@index([userId], map: "idx_organization_mandates_user")
  @@map("organization_leadership_mandates")
}

model OrganizationMandateDecision {
  expiresOn      DateTime?                       @map("expires_on") @db.Date
  id             BigInt                          @id @default(autoincrement()) @db.BigInt
  organizationId String                          @map("organization_id") @db.VarChar(80)
  organization   Organization                    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  decisionNumber String                          @map("decision_number") @db.VarChar(80)
  decisionDate   DateTime                        @map("decision_date") @db.Date
  issuingBody    String                          @map("issuing_body") @db.VarChar(180)
  minutesPath    String                          @map("minutes_path") @db.VarChar(320)
  createdBy      BigInt                          @map("created_by") @db.BigInt
  createdAt      DateTime                        @default(now()) @map("created_at") @db.Timestamptz(6)
  mandates       OrganizationLeadershipMandate[]

  @@unique([organizationId, decisionNumber])
  @@index([organizationId, decisionDate])
  @@map("organization_mandate_decisions")
}

model OrganizationObjective {
  id             BigInt       @id @default(autoincrement()) @db.BigInt
  organizationId String       @map("organization_id") @db.VarChar(80)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String       @db.VarChar(180)
  description    String       @default("") @db.Text
  metricName     String       @default("") @map("metric_name") @db.VarChar(120)
  targetValue    Decimal      @map("target_value") @db.Decimal(14, 2)
  currentValue   Decimal      @default(0) @map("current_value") @db.Decimal(14, 2)
  unit           String       @default("număr") @db.VarChar(40)
  dueDate        DateTime     @map("due_date") @db.Date
  status         String       @default("planned") @db.VarChar(20)
  isDemo         Boolean      @default(false) @map("is_demo")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([organizationId, status], map: "idx_organization_objectives_org_status")
  @@index([dueDate], map: "idx_organization_objectives_due_date")
  @@map("organization_objectives")
}

model ArbitrationCase {
  id             BigInt                @id @default(autoincrement()) @db.BigInt
  caseNumber     String                @unique @map("case_number") @db.VarChar(80)
  organizationId String?               @map("organization_id") @db.VarChar(80)
  organization   Organization?         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  caseType       String                @map("case_type") @db.VarChar(30)
  subject        String                @db.VarChar(180)
  facts          String                @db.Text
  legalBasis     String                @default("") @map("legal_basis") @db.Text
  status         String                @default("submitted") @db.VarChar(24)
  filedBy        BigInt                @map("filed_by") @db.BigInt
  filedAt        DateTime              @default(now()) @map("filed_at") @db.Timestamptz(6)
  responseDueAt  DateTime?             @map("response_due_at") @db.Timestamptz(6)
  decidedAt      DateTime?             @map("decided_at") @db.Timestamptz(6)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime              @default(now()) @map("updated_at") @db.Timestamptz(6)
  parties        ArbitrationParty[]
  evidence       ArbitrationEvidence[]
  conflicts      ArbitrationConflict[]
  decisions      ArbitrationDecision[]
  appeals        ArbitrationAppeal[]

  @@map("arbitration_cases")
}

model ArbitrationParty {
  id                 BigInt          @id @default(autoincrement()) @db.BigInt
  caseId             BigInt          @map("case_id") @db.BigInt
  case               ArbitrationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  userId             BigInt?         @map("user_id") @db.BigInt
  fullName           String          @map("full_name") @db.VarChar(160)
  partyRole          String          @map("party_role") @db.VarChar(20)
  notifiedAt         DateTime?       @map("notified_at") @db.Timestamptz(6)
  responseReceivedAt DateTime?       @map("response_received_at") @db.Timestamptz(6)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("arbitration_parties")
}

model ArbitrationEvidence {
  id           BigInt          @id @default(autoincrement()) @db.BigInt
  caseId       BigInt          @map("case_id") @db.BigInt
  case         ArbitrationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  submittedBy  BigInt          @map("submitted_by") @db.BigInt
  title        String          @db.VarChar(180)
  documentPath String          @map("document_path") @db.VarChar(320)
  description  String          @default("") @db.Text
  submittedAt  DateTime        @default(now()) @map("submitted_at") @db.Timestamptz(6)

  @@map("arbitration_evidence")
}

model ArbitrationConflict {
  id               BigInt          @id @default(autoincrement()) @db.BigInt
  caseId           BigInt          @map("case_id") @db.BigInt
  case             ArbitrationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  arbitratorUserId BigInt          @map("arbitrator_user_id") @db.BigInt
  reason           String          @db.Text
  status           String          @default("declared") @db.VarChar(20)
  declaredAt       DateTime        @default(now()) @map("declared_at") @db.Timestamptz(6)
  resolvedAt       DateTime?       @map("resolved_at") @db.Timestamptz(6)

  @@unique([caseId, arbitratorUserId])
  @@map("arbitration_conflicts")
}

model ArbitrationDecision {
  expiresOn DateTime?        @map("expires_on") @db.Date
  id        BigInt          @id @default(autoincrement()) @db.BigInt
  caseId    BigInt          @map("case_id") @db.BigInt
  case      ArbitrationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  decidedBy BigInt          @map("decided_by") @db.BigInt
  outcome   String          @db.VarChar(24)
  reasoning String          @db.Text
  decidedAt DateTime        @default(now()) @map("decided_at") @db.Timestamptz(6)

  @@map("arbitration_decisions")
}

model ArbitrationAppeal {
  id         BigInt          @id @default(autoincrement()) @db.BigInt
  caseId     BigInt          @map("case_id") @db.BigInt
  case       ArbitrationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  appealedBy BigInt          @map("appealed_by") @db.BigInt
  grounds    String          @db.Text
  status     String          @default("submitted") @db.VarChar(20)
  filedAt    DateTime        @default(now()) @map("filed_at") @db.Timestamptz(6)
  dueAt      DateTime?       @map("due_at") @db.Timestamptz(6)
  decidedAt  DateTime?       @map("decided_at") @db.Timestamptz(6)

  @@map("arbitration_appeals")
}

model MembershipRecord {
  id                     BigInt            @id @default(autoincrement()) @db.BigInt
  userId                 BigInt?           @unique @map("user_id") @db.BigInt
  user                   User?             @relation("MembershipSubjectUser", fields: [userId], references: [id], onDelete: SetNull)
  volunteerId            BigInt?           @unique @map("volunteer_id") @db.BigInt
  volunteer              Volunteer?        @relation(fields: [volunteerId], references: [id], onDelete: SetNull)
  fullName               String            @map("full_name") @db.VarChar(160)
  email                  String            @db.VarChar(180)
  status                 String            @default("application") @db.VarChar(20)
  isDemo                 Boolean           @default(false) @map("is_demo")
  organizationId         String?           @map("organization_id") @db.VarChar(80)
  organization           Organization?     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  memberNumber           String?           @unique(map: "idx_membership_records_member_number_unique") @map("member_number") @db.VarChar(32)
  applicationAt          DateTime          @default(now()) @map("application_at") @db.Timestamptz(6)
  validatedAt            DateTime?         @map("validated_at") @db.Timestamptz(6)
  approvedAt             DateTime?         @map("approved_at") @db.Timestamptz(6)
  approvalOrganizationId String?           @map("approval_organization_id") @db.VarChar(80)
  approvalOrganization   Organization?     @relation("MembershipApprovalOrganization", fields: [approvalOrganizationId], references: [id], onDelete: Restrict)
  approvalBody           String            @default("") @map("approval_body") @db.VarChar(180)
  joinedAt               DateTime?         @map("joined_at") @db.Timestamptz(6)
  suspendedAt            DateTime?         @map("suspended_at") @db.Timestamptz(6)
  endedAt                DateTime?         @map("ended_at") @db.Timestamptz(6)
  statusReason           String            @default("") @map("status_reason") @db.Text
  version                Int               @default(1)
  createdBy              BigInt?           @map("created_by") @db.BigInt
  createdByRef           User?             @relation("MembershipCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedBy              BigInt?           @map("updated_by") @db.BigInt
  updatedByRef           User?             @relation("MembershipUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  events                 MembershipEvent[]
  createdAt              DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
