PORT=4000
# Default: 127.0.0.1 in production, 0.0.0.0 in development/test.
# BIND_HOST=127.0.0.1
HTTP_SERVER_ADAPTER=fastify
APP_NAME=pcp-api
# APP_VERSION=2.0.0
# APP_RELEASE=enterprise-modernized
# APP_COMMIT_SHA=
# APP_BUILD_TIME=2026-03-05T00:00:00Z
# Dev default; in productie foloseste originea publica a frontend-ului.
CORS_ORIGIN=http://localhost:5173
# Keep true for cookie-based auth; when true CORS_ORIGIN cannot contain '*'
CORS_CREDENTIALS=true
LOG_LEVEL=info
TRUST_PROXY=false
# In productie, cookie-urile auth sunt setate automat cu atributul Secure.
# FORCE_HTTPS_UPGRADE activeaza si redirect/HSTS la nivel HTTP.
FORCE_HTTPS_UPGRADE=false
# Observability (Prometheus metrics endpoint: GET /api/metrics)
# Lasa necompletat pentru default-ul pe mediu:
# - development/test: true
# - production: false
# Pentru productie, activeaza explicit doar dupa ce setezi un token dedicat.
# METRICS_ENABLED=true
# METRICS_BEARER_TOKEN=generate_a_long_random_metrics_token
AUTH_RATE_LIMIT_WINDOW_MS=600000
AUTH_RATE_LIMIT_MAX=10
HEALTHCHECK_DB_TIMEOUT_MS=2000
SHUTDOWN_GRACE_MS=15000
AUTH_TOKEN_TTL_SECONDS=86400
# In development/test poate lipsi; in productie seteaza minimum 32 caractere random.
# AUTH_TOKEN_SECRET=generate_minimum_32_chars_random_secret
AUTH_TOKEN_ISSUER=pcp-api
AUTH_TOKEN_AUDIENCE=pcp-client
# Recomandat in productie; PM2 il activeaza explicit pentru sesiuni persistente.
AUTH_REFRESH_ENABLED=true
# Trebuie sa fie strict mai mare decat AUTH_TOKEN_TTL_SECONDS cand refresh este activ.
AUTH_REFRESH_TTL_SECONDS=1209600
# Store pentru refresh sessions: sql | redis
AUTH_REFRESH_STORE=sql
# Obligatoriul cand AUTH_REFRESH_STORE=redis; portul local implicit vine din docker compose.
# REDIS_URL=redis://127.0.0.1:6381/0
# REDIS_KEY_PREFIX=pcp
# REDIS_CONNECT_TIMEOUT_MS=3000
# Optional email notifications (signup / volunteer status / news publish)
EMAIL_NOTIFICATIONS_ENABLED=false
EMAIL_FROM=no-reply@pcp.local
# EMAIL_REPLY_TO=contact@pcp.local
EMAIL_SMTP_HOST=localhost
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_REQUIRE_STARTTLS=true
# EMAIL_SMTP_USER=your_smtp_user
# EMAIL_SMTP_PASS=your_smtp_password
EMAIL_SEND_TIMEOUT_MS=12000
# EMAIL_NEWS_PUBLISH_RECIPIENTS=presa@example.org,comunicare@example.org
# PUBLIC_BASE_URL=https://example.org
VOLUNTEER_RATE_LIMIT_WINDOW_MS=600000
VOLUNTEER_RATE_LIMIT_MAX=5
# Optional captcha verification (Cloudflare Turnstile compatible)
# CAPTCHA_MODE=optional
# CAPTCHA_SECRET_KEY=your_secret
# CAPTCHA_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
# CAPTCHA_EXPECTED_ACTION=volunteer_signup
# CAPTCHA_EXPECTED_HOSTNAME=example.org
# CAPTCHA_MIN_SCORE=0.5
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=pcp_db
POSTGRES_USER=pcp_user
# Credential dev-only pentru docker compose local. Schimba-l in orice mediu partajat sau productie.
POSTGRES_PASSWORD=pcp_local_dev_password
# Optional: use this instead of POSTGRES_* values
# DATABASE_URL=postgres://user:password@host:port/database
# Obligatoriu pentru smoke/integration/full-stack; numele bazei trebuie sa contina test/testing.
# TEST_DATABASE_URL=postgres://pcp_user:password@localhost:5433/pcp_test
# Optional cleanup batch controls for auth token maintenance script
# AUTH_TOKEN_CLEANUP_BATCH_LIMIT=5000
# AUTH_TOKEN_CLEANUP_MAX_BATCHES=20
# Optional outbox batch controls for email notification worker
# EMAIL_OUTBOX_BATCH_LIMIT=50
# EMAIL_OUTBOX_MAX_BATCHES=20
# EMAIL_OUTBOX_BASE_DELAY_SECONDS=30
# EMAIL_OUTBOX_MAX_DELAY_SECONDS=3600
