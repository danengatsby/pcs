NODE_ENV=production
PORT=4000
APP_INSTANCE_COUNT=1
BIND_HOST=127.0.0.1
APP_NAME=pcs-api
APP_VERSION=2.0.0
APP_RELEASE=production-release
APP_COMMIT_SHA=replace-with-git-sha
APP_BUILD_TIME=2026-09-02T00:00:00Z
PUBLIC_BASE_URL=https://example.org
CORS_ORIGIN=https://example.org
CORS_CREDENTIALS=true
LOG_LEVEL=info
TRUST_PROXY=false
FORCE_HTTPS_UPGRADE=true
AUTH_RATE_LIMIT_WINDOW_MS=600000
AUTH_RATE_LIMIT_MAX=10
HEALTHCHECK_DB_TIMEOUT_MS=2000
SHUTDOWN_GRACE_MS=15000
AUTH_TOKEN_TTL_SECONDS=86400
AUTH_TOKEN_SECRET=replace-with-at-least-32-random-characters
AUTH_TOKEN_ISSUER=pcs-api
AUTH_TOKEN_AUDIENCE=pcs-client
AUTH_REFRESH_ENABLED=true
AUTH_REFRESH_TTL_SECONDS=1209600
AUTH_REFRESH_STORE=sql
# Required when APP_INSTANCE_COUNT is greater than 1.
# RATE_LIMIT_STORE=redis
# REDIS_URL=redis://127.0.0.1:6381/0
EMAIL_NOTIFICATIONS_ENABLED=false
EMAIL_FROM=no-reply@example.org
EMAIL_SMTP_HOST=smtp.example.org
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_REQUIRE_STARTTLS=true
EMAIL_SEND_TIMEOUT_MS=12000
VOLUNTEER_RATE_LIMIT_WINDOW_MS=600000
VOLUNTEER_RATE_LIMIT_MAX=5
CAPTCHA_MODE=required
CAPTCHA_SECRET_KEY=replace-with-turnstile-secret
CAPTCHA_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
CAPTCHA_EXPECTED_ACTION=volunteer_signup
CAPTCHA_EXPECTED_HOSTNAME=example.org
NEWS_MEDIA_CLAMAV_ENABLED=1
NEWS_MEDIA_CLAMAV_MODE=clamd
NEWS_MEDIA_CLAMD_HOST=127.0.0.1
NEWS_MEDIA_CLAMD_PORT=3310
NEWS_MEDIA_CLAMAV_TIMEOUT_MS=30000
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=pcs_db
POSTGRES_USER=pcs_user
POSTGRES_PASSWORD=replace-with-database-password
# Or use DATABASE_URL instead of POSTGRES_* values.
# DATABASE_URL=postgres://user:password@host:port/database
